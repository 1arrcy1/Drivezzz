<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes in a backup: the login and the chat keys live in this phone's Keystore and wouldn't open anywhere else. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
