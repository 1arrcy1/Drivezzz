    "Taxi" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxi"
          }
        }
      }
    },
    "Taxi permit" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxivergunning"
          }
        }
      }
    },
    "Taxi permit (Kiwa)" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxivergunning (Kiwa)"
          }
        }
      }
    },
    "Tell support why you need another wallet. Once they say yes you can change it once, and then it locks again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertel de helpdesk waarom je een andere wallet nodig hebt. Als ze ja zeggen kun je hem één keer wijzigen, en daarna zit hij weer vast."
          }
        }
      }
    },
    "Tell us what happened" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertel ons wat er gebeurd is"
          }
        }
      }
    },
    "Terms" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorwaarden"
          }
        }
      }
    },
    "Test network" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testnetwerk"
          }
        }
      }
    },
    "Thanks. We look at reports within 24 hours." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedankt. We bekijken meldingen binnen 24 uur."
          }
        }
      }
    },
    "That didn’t work." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat lukte niet."
          }
        }
      }
    },
    "That message has a word that isn’t allowed." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat bericht bevat een woord dat niet is toegestaan."
          }
        }
      }
    },
    "That photo can’t be used." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die foto kan niet gebruikt worden."
          }
        }
      }
    },
    "That took too long. Try again in good light, with the phone in front of your face." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat duurde te lang. Probeer het opnieuw in goed licht, met de telefoon voor je gezicht."
          }
        }
      }
    },
    "The %@" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %@"
          }
        }
      }
    },
    "The %lld cheapest are on the map." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %lld goedkoopste staan op de kaart."
          }
        }
      }
    },
    "The 8 digits of your business at the Kamer van Koophandel (or the taxi company you drive for)." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 8 cijfers van je bedrijf bij de Kamer van Koophandel (of van het taxibedrijf waarvoor je rijdt)."
          }
        }
      }
    },
    "The back of your ID card" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De achterkant van je ID-kaart"
          }
        }
      }
    },
    "The camera can’t be used. Type the details in instead." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De camera kan niet gebruikt worden. Typ de gegevens in plaats daarvan in."
          }
        }
      }
    },
    "The car" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De auto"
          }
        }
      }
    },
    "The cheapest driver right now asks %@." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De goedkoopste chauffeur vraagt nu %@."
          }
        }
      }
    },
    "The chip was lost before it was read. Hold the phone still against it and try again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De chip ging verloren voordat hij gelezen was. Houd de telefoon stil ertegen en probeer het opnieuw."
          }
        }
      }
    },
    "The connection was cut." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding werd verbroken."
          }
        }
      }
    },
    "The face check couldn’t start. Update Drivezzz." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gezichtscontrole kon niet starten. Werk Drivezzz bij."
          }
        }
      }
    },
    "The front camera can’t be used." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De camera aan de voorkant kan niet gebruikt worden."
          }
        }
      }
    },
    "The front of your chauffeurskaart, with your photo, its number and the date it’s valid until." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De voorkant van je chauffeurskaart, met je foto, het nummer en de datum tot wanneer hij geldig is."
          }
        }
      }
    },
    "The other person" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ander"
          }
        }
      }
    },
    "The plate can’t be read in this photo. In the Netherlands a person then has to check it, so take one with the plate clearly in view." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kenteken is op deze foto niet te lezen. In Nederland moet een persoon het dan controleren, dus maak er een met het kenteken goed in beeld."
          }
        }
      }
    },
    "The ride" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De rit"
          }
        }
      }
    },
    "The rider checks in once they’re inside the car." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De passagier checkt in zodra die in de auto zit."
          }
        }
      }
    },
    "The rider gets everything back and you aren’t paid." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De passagier krijgt alles terug en jij wordt niet betaald."
          }
        }
      }
    },
    "The rider gets everything back, also now they’re checked in, and you aren’t paid." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De passagier krijgt alles terug, ook nu die ingecheckt is, en jij wordt niet betaald."
          }
        }
      }
    },
    "The rider hasn’t paid yet, so no money moves." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De passagier heeft nog niet betaald, dus er gaat geen geld heen en weer."
          }
        }
      }
    },
    "The rider named this price for the ride. Your way to the pickup (voorrijkosten, %@) isn’t paid on top: %@ is all you get." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The rider named this price for the ride. Your way to the pickup (voorrijkosten, %1$@) isn’t paid on top: %2$@ is all you get."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De passagier noemde deze prijs voor de rit. Je rit naar het ophaalpunt (voorrijkosten, %1$@) wordt niet extra betaald: %2$@ is alles wat je krijgt."
          }
        }
      }
    },
    "The rider pays you in cash." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De passagier betaalt je contant."
          }
        }
      }
    },
    "The side without your photo, with three lines of <<< at the bottom. With a passport it’s the two lines at the bottom of the photo page. What it reads opens your ID’s chip." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kant zonder je foto, met onderaan drie regels met <<<. Bij een paspoort zijn het de twee regels onderaan de pagina met je foto. Wat erop staat opent de chip van je ID."
          }
        }
      }
    },
    "The side without your photo. Put the lines with <<< in the frame, about 25 cm from the phone." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kant zonder je foto. Zet de regels met <<< in het kader, ongeveer 25 cm van de telefoon."
          }
        }
      }
    },
    "The wallet answered with something Drivezzz can’t read." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wallet antwoordde met iets wat Drivezzz niet kan lezen."
          }
        }
      }
    },
    "The wallet didn’t answer in time. Try again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wallet reageerde niet op tijd. Probeer het opnieuw."
          }
        }
      }
    },
    "The wallet didn’t finish connecting. Try again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wallet maakte de verbinding niet af. Probeer het opnieuw."
          }
        }
      }
    },
    "The wallet refused%@" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wallet weigerde%@"
          }
        }
      }
    },
    "The wallet said no:%@." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wallet zei nee:%@."
          }
        }
      }
    },
    "The wallet you paid with" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wallet waarmee je betaalde"
          }
        }
      }
    },
    "Then" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daarna"
          }
        }
      }
    },
    "These are checked automatically. If something can’t be confirmed, a person looks at it once you’ve sent all four. Then you’re verified, with a blue check on your profile, and you can go online as a taxi driver." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze worden automatisch gecontroleerd. Als iets niet bevestigd kan worden, kijkt een persoon ernaar zodra je ze alle vier hebt gestuurd. Dan ben je geverifieerd, met een blauw vinkje op je profiel, en kun je online gaan als taxichauffeur."
          }
        }
      }
    },
    "These details don’t open the chip. Check the document number and both dates." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met deze gegevens gaat de chip niet open. Controleer het documentnummer en beide datums."
          }
        }
      }
    },
    "This ID has run out: you need one that’s still valid." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze ID is verlopen: je hebt er een nodig die nog geldig is."
          }
        }
      }
    },
    "This can’t be undone." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
    "This chip couldn’t be read. Try again, or try your other document." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze chip kon niet gelezen worden. Probeer het opnieuw, of probeer je andere document."
          }
        }
      }
    },
    "This device can’t read chips. Use an iPhone." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat kan geen chips lezen. Gebruik een iPhone."
          }
        }
      }
    },
    "This drive is added to the report, so we can see the planned route on a map. If you’ve messaged %@, your chat is added too." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze rit wordt aan de melding toegevoegd, zodat we de geplande route op een kaart kunnen zien. Als je %@ berichten hebt gestuurd, wordt je chat ook toegevoegd."
          }
        }
      }
    },
    "This driver doesn’t take this." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze chauffeur neemt dit niet aan."
          }
        }
      }
    },
    "This iPhone can’t read chips." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze iPhone kan geen chips lezen."
          }
        }
      }
    },
    "This message can’t be read on this phone." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit bericht kan op deze telefoon niet gelezen worden."
          }
        }
      }
    },
    "This ride is paid in cash, so no money moves." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze rit wordt contant betaald, dus er gaat geen geld heen en weer."
          }
        }
      }
    },
    "This rider chose you, at your own price with your way to the pickup in it. Nobody else can claim it for now. %@" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze passagier koos jou, voor je eigen prijs met je rit naar het ophaalpunt erin. Niemand anders kan hem voorlopig aannemen. %@"
          }
        }
      }
    },
    "This route is saved" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze route is bewaard"
          }
        }
      }
    },
    "This server doesn’t do these checks yet." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze server doet deze controles nog niet."
          }
        }
      }
    },
    "This version of the app can’t read that. Update the app." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze versie van de app kan dat niet lezen. Werk de app bij."
          }
        }
      }
    },
    "This wallet didn’t share an address for any of our coins. Turn them on in the wallet, or pick another wallet." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze wallet deelde geen adres voor een van onze munten. Zet ze aan in de wallet, of kies een andere wallet."
          }
        }
      }
    },
    "Time left" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resterende tijd"
          }
        }
      }
    },
    "To claim this: turn on %@ in Wallet, and on My page use a %@ with enough seats%@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To claim this: turn on %1$@ in Wallet, and on My page use a %2$@ with enough seats%3$@."
          }
        },
        "nl" : {
          "stringUnit" : {
