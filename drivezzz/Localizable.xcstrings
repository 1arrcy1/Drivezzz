    },
    "Your wallet" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wallet"
          }
        }
      }
    },
    "Your wallet app opens to approve this. If it stays there afterwards, come back here yourself. Your keys stay in your wallet." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wallet-app opent om dit goed te keuren. Als hij daarna blijft staan, kom dan zelf hier terug. Je sleutels blijven in je wallet."
          }
        }
      }
    },
    "Your wallet is locked, so someone who gets into your account can’t send your money elsewhere. Support can unlock it for one change." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wallet zit vast, zodat iemand die in je account komt je geld niet ergens anders heen kan sturen. De helpdesk kan hem vrijgeven voor één wijziging."
          }
        }
      }
    },
