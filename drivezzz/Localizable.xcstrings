    "Hatchback" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hatchback"
          }
        }
      }
    },
    "Heads-up: the rider’s phone wasn’t within 500 m of the drop-off at check-out. If you dropped them off correctly, you can ignore this. They have 24 hours to appeal." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op: de telefoon van de passagier was bij het uitchecken niet binnen 500 m van de bestemming. Als je de passagier op de goede plek hebt afgezet, kun je dit negeren. De passagier heeft 24 uur om bezwaar te maken."
          }
        }
      }
    },
    "Heads-up: the rider’s phone wasn’t within 500 m of the drop-off when you checked out. If you dropped them off correctly, you can ignore this. They have 24 hours to appeal." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op: de telefoon van de passagier was niet binnen 500 m van de bestemming toen je uitcheckte. Als je de passagier op de goede plek hebt afgezet, kun je dit negeren. De passagier heeft 24 uur om bezwaar te maken."
          }
        }
      }
    },
    "Heads-up: your phone wasn’t within 500 m of the drop-off when you were checked out. If you were dropped off correctly, you can ignore this. If not, you have 24 hours to appeal." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op: je telefoon was niet binnen 500 m van de bestemming toen je werd uitgecheckt. Als je op de goede plek bent afgezet, kun je dit negeren. Zo niet, dan heb je 24 uur om bezwaar te maken."
          }
        }
      }
    },
    "Held in escrow on Solana until your ride is done." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastgehouden in escrow op Solana tot je rit klaar is."
          }
        }
      }
    },
    "Held in escrow until the ride is done, then paid to your driver." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastgehouden in escrow tot de rit klaar is, daarna betaald aan je chauffeur."
          }
        }
      }
