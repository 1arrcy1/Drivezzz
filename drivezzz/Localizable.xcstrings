    },
    "Tap to add" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik om toe te voegen"
          }
        }
      }
    },
    "Tap to replace" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik om te vervangen"
          }
        }
      }
