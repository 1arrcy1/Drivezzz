    "We look at your route and the rider’s, and answer here." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We bekijken jouw route en die van de passagier, en antwoorden hier."
          }
        }
      }
    },
    "We look up its plate in the RDW’s open register: registered as a taxi, insured, APK. The plate must be readable on the photo of its back." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
