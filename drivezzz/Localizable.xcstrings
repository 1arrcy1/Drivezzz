            "value" : "Je betaalt je chauffeur contant."
          }
        }
      }
    },
    "You were put offline: you didn’t answer a ride within 5 minutes. Go online again when you’re ready." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent offline gezet: je reageerde niet binnen 5 minuten op een rit. Ga weer online als je er klaar voor bent."
          }
        }
      }
    },
    "You won’t be matched with each other any more. A ride under way carries on. You can undo this in Profile." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jullie worden niet meer aan elkaar gekoppeld. Een rit die bezig is gaat door. Je kunt dit ongedaan maken bij Profiel."
          }
        }
      }
    },
    "You: %@" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij: %@"
          }
        }
