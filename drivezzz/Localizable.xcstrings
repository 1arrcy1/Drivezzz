    },
    "Tap for their profile" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik voor zijn profiel"
          }
        }
      }
    },
    "Tap the bookmark on a route on Home to keep it here, with a name. A ride’s page can save its route too." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de bladwijzer bij een route op Home om hem hier te bewaren, met een naam. Ook de pagina van een rit kan de route bewaren."
          }
