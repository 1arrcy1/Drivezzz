    },
    "Your driver is on the way" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je chauffeur is onderweg"
          }
        }
      }
    },
    "Your driver waits here. Hold the map to move it." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je chauffeur wacht hier. Houd de kaart vast om het te verplaatsen."
          }
        }
      }
    },
    "Your face" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gezicht"
          }
        }
      }
    },
    "Your face is compared on this phone and never sent. We never read your BSN or address. Photos of your documents are deleted 30 days after the decision." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gezicht wordt op deze telefoon vergeleken en nooit verstuurd. We lezen nooit je BSN of adres. Foto's van je documenten worden 30 dagen na het besluit verwijderd."
          }
        }
      }
    },
    "Your face matches your ID." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gezicht komt overeen met je ID."
          }
        }
      }
    },
    "Your face matches your ID. A person confirms it once more before you’re verified. You can carry on with the rest." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gezicht komt overeen met je ID. Een persoon bevestigt het nog een keer voordat je geverifieerd bent. Je kunt verder met de rest."
          }
        }
      }
    },
    "Your finished drives and what you earned show here." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
