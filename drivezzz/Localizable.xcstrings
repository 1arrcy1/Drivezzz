        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarom annuleer je?"
          }
        }
      }
    },
    "Why do you want to change it?" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarom wil je hem wijzigen?"
          }
        }
      }
    },
    "With cash you have less protection, and your transaction is finalised with the driver." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij contant betalen ben je minder beschermd, en je transactie wordt met de chauffeur afgehandeld."
          }
        }
      }
    },
    "With the email and password you added in Profile." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
