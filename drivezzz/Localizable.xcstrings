    },
    "You can appeal until %@." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt bezwaar maken tot %@."
          }
        }
      }
    },
    "You can cancel for a full refund until you check in." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt annuleren en alles terugkrijgen tot je incheckt."
          }
        }
      }
    },
    "You can cancel for a full refund until you check in. Check the map first: if your driver is clearly coming, we recommend waiting." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt annuleren en alles terugkrijgen tot je incheckt. Kijk eerst op de kaart: als je chauffeur duidelijk onderweg is, raden we aan te wachten."
          }
        }
      }
    },
    "You can check in within 100 m of your driver." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt inchecken binnen 100 m van je chauffeur."
          }
        }
      }
    },
    "You can drive in the Netherlands" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt rijden in Nederland"
