    "You’re offline" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent offline"
          }
        }
      }
    },
    "You’re online" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent online"
          }
        }
      }
    },
    "You’re paid to this wallet, in the coin your rider paid with. Turn on the coins you take." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
