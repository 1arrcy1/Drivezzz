            "value" : "Je chauffeur is te laat"
          }
        }
      }
    },
    "Your driver is late, so everything goes back to the wallet you paid with, and your driver gets nothing." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je chauffeur is te laat, dus alles gaat terug naar de wallet waarmee je betaalde, en je chauffeur krijgt niets."
          }
