        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorkant van de %@"
          }
        }
      }
    },
    "Further away means a longer way to the pickup, which isn’t paid on a rider’s named price." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verder weg betekent een langere rit naar het ophaalpunt, en die wordt niet betaald bij een prijs die de passagier zelf noemt."
