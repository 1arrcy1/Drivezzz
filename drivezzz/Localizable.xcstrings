    "You can switch to riding once this drive is over." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt naar meerijden overschakelen als deze rit voorbij is."
          }
        }
      }
    },
    "You cancelled." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt geannuleerd."
          }
        }
      }
    },
    "You can’t appeal again from the app." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt vanuit de app niet opnieuw bezwaar maken."
          }
        }
      }
    },
    "You declined in your wallet." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt geweigerd in je wallet."
          }
        }
      }
    },
    "You don’t need a wallet here to ride: you pick one when you pay. Only drivers connect one, to get paid." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt hier geen wallet nodig om mee te rijden: je kiest er een als je betaalt. Alleen chauffeurs koppelen er een, om betaald te worden."
          }
        }
      }
    },
    "You drive for yourself" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je rijdt voor jezelf"
          }
        }
      }
    },
    "You get %@." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je krijgt %@."
          }
        }
      }
    },
    "You have a rider. Finish the drive, or cancel it, before you go offline." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt een passagier. Maak de rit af, of annuleer hem, voordat je offline gaat."
          }
        }
      }
    },
    "You haven’t paid anything: cancelling is free." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt nog niets betaald: annuleren is gratis."
          }
        }
      }
    },
    "You pay %@ in cash, in the car. You can still cancel, for free." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je betaalt %@ contant, in de auto. Je kunt nog annuleren, gratis."
          }
        }
      }
    },
    "You pay once a driver claims it." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je betaalt zodra een chauffeur hem aanneemt."
