    },
    "Support" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hulp"
          }
        }
      }
    },
    "Support didn’t allow your last request. You can ask again and explain more." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De helpdesk heeft je vorige aanvraag niet toegestaan. Je kunt het opnieuw vragen en meer uitleggen."
          }
        }
      }
    },
    "Support said yes: you can change your wallet once." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De helpdesk zei ja: je kunt je wallet één keer wijzigen."
          }
        }
      }
    },
    "Take cash" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contant aannemen"
          }
        }
