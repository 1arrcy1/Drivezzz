        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent geverifieerd"
          }
        }
      }
    },
    "You’re verified: you can go online as a taxi driver in the Netherlands. Riders see your blue check." : {
      "localizations" : {
        "nl" : {
